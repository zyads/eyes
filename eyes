# ------------------------------------------------------------------ state/dirs


def ensure_state():
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    os.makedirs(HISTORY, mode=0o700, exist_ok=True)
    os.chmod(STATE, 0o700)


def _write_secret(path, text):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text + "\n")


def get_token(fresh=False):
    if not fresh and os.path.exists(TOKEN_FILE):
        tok = open(TOKEN_FILE).read().strip()
        if tok:
            return tok
    tok = secrets.token_urlsafe(16)
    _write_secret(TOKEN_FILE, tok)
    return tok


def get_e2e_key(create=False):
    """32-byte AES key, stored base64url. Carried to the phone in the URL
    *fragment* only — the fragment is never sent in HTTP requests, so no
    intermediary (including Cloudflare) ever sees it."""
    if os.path.exists(E2E_KEY_FILE):
        raw = base64.urlsafe_b64decode(open(E2E_KEY_FILE).read().strip() + "==")
        if len(raw) == 32:
            return raw
    if not create:
        return None
    raw = secrets.token_bytes(32)
    _write_secret(E2E_KEY_FILE, base64.urlsafe_b64encode(raw).decode().rstrip("="))
    return raw


def b64u(raw):
    return base64.urlsafe_b64encode(raw).decode().rstrip("=")


def lan_ip():
    """Best-effort LAN address. UDP connect() sends no packets — it only asks
    the kernel which source address would be used for that route."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.0.2.1", 9))  # TEST-NET-1, never actually contacted
        return s.getsockname()[0]
    except OSError:
        return None
    finally:
        s.close()


# ------------------------------------------------------- AES-256-GCM (libcrypto)
# WebCrypto on the phone speaks AES-GCM natively; Python's stdlib has no AES,
# so we call the system libcrypto directly through ctypes (same spirit as
# using the system openssl binary — no pip packages). WebCrypto's ciphertext
# layout is ct||tag with a 16-byte tag, which is exactly EVP's.

_EVP_CTRL_AEAD_SET_IVLEN, _EVP_CTRL_AEAD_GET_TAG, _EVP_CTRL_AEAD_SET_TAG = 0x9, 0x10, 0x11


class GCM:
    def __init__(self):
        name = ctypes.util.find_library("crypto") or "libcrypto.so.3"
        L = ctypes.CDLL(name)
        L.EVP_CIPHER_CTX_new.restype = ctypes.c_void_p
        L.EVP_aes_256_gcm.restype = ctypes.c_void_p
        P, I = ctypes.c_void_p, ctypes.c_int
        buf, ip = ctypes.c_char_p, ctypes.POINTER(I)
        L.EVP_CIPHER_CTX_free.argtypes = [P]
        L.EVP_CIPHER_CTX_ctrl.argtypes = [P, I, I, P]
        for f in (L.EVP_EncryptInit_ex, L.EVP_DecryptInit_ex):
            f.argtypes = [P, P, P, buf, buf]
        for f in (L.EVP_EncryptUpdate, L.EVP_DecryptUpdate):
            f.argtypes = [P, ctypes.c_void_p, ip, buf, I]
        for f in (L.EVP_EncryptFinal_ex, L.EVP_DecryptFinal_ex):
            f.argtypes = [P, ctypes.c_void_p, ip]
        self.L = L

    def open(self, key, iv, ct_tag):
        """Decrypt+authenticate WebCrypto AES-GCM output. None on failure."""
        if len(ct_tag) < 16:
            return None
        ct, tag = ct_tag[:-16], ct_tag[-16:]
        L = self.L
        ctx = L.EVP_CIPHER_CTX_new()
        try:
            out = ctypes.create_string_buffer(max(len(ct), 1))
            outl, finl = ctypes.c_int(0), ctypes.c_int(0)
            fin = ctypes.create_string_buffer(16)
            if not (
                L.EVP_DecryptInit_ex(ctx, L.EVP_aes_256_gcm(), None, None, None)
                and L.EVP_CIPHER_CTX_ctrl(ctx, _EVP_CTRL_AEAD_SET_IVLEN, len(iv), None)
                and L.EVP_DecryptInit_ex(ctx, None, None, key, iv)
                and L.EVP_DecryptUpdate(ctx, out, ctypes.byref(outl), ct, len(ct))
                and L.EVP_CIPHER_CTX_ctrl(
                    ctx, _EVP_CTRL_AEAD_SET_TAG, 16, ctypes.c_char_p(tag)
                )
                and L.EVP_DecryptFinal_ex(ctx, fin, ctypes.byref(finl)) == 1
            ):
                return None
            return out.raw[: outl.value]
        finally:
            L.EVP_CIPHER_CTX_free(ctx)

    def seal(self, key, iv, pt):
        """Encrypt like WebCrypto would (ct||tag). Used by the self-tests."""
        L = self.L
        ctx = L.EVP_CIPHER_CTX_new()
        try:
            out = ctypes.create_string_buffer(max(len(pt), 1))
            outl, finl = ctypes.c_int(0), ctypes.c_int(0)
            fin = ctypes.create_string_buffer(16)
            tag = ctypes.create_string_buffer(16)
            assert (
                L.EVP_EncryptInit_ex(ctx, L.EVP_aes_256_gcm(), None, None, None)
                and L.EVP_CIPHER_CTX_ctrl(ctx, _EVP_CTRL_AEAD_SET_IVLEN, len(iv), None)
                and L.EVP_EncryptInit_ex(ctx, None, None, key, iv)
                and L.EVP_EncryptUpdate(ctx, out, ctypes.byref(outl), pt, len(pt))
                and L.EVP_EncryptFinal_ex(ctx, fin, ctypes.byref(finl))
                and L.EVP_CIPHER_CTX_ctrl(ctx, _EVP_CTRL_AEAD_GET_TAG, 16, tag)
            )
            return out.raw[: outl.value] + tag.raw
        finally:
            L.EVP_CIPHER_CTX_free(ctx)


# ----------------------------------------------------------------------- certs


def _openssl(*args, **kw):
    return subprocess.run(
        ("openssl",) + args, check=True, capture_output=True, text=True, **kw
    )


def ensure_ca():
    """One local CA, generated once, valid 10 years. The phone trusts this
    once; leaf certs can then change freely (e.g. when the LAN IP changes)."""
    if os.path.exists(CA_CERT) and os.path.exists(CA_KEY):
        return False
    _openssl(
        "req", "-x509", "-newkey", "rsa:2048", "-sha256", "-days", "3650",
        "-nodes", "-keyout", CA_KEY, "-out", CA_CERT,
        "-subj", "/CN=eyes local CA/O=eyes",
        "-addext", "basicConstraints=critical,CA:true",
        "-addext", "keyUsage=critical,keyCertSign,cRLSign",
    )
    os.chmod(CA_KEY, 0o600)
    return True


def ensure_leaf(ip):
    """Issue (or re-issue) the server cert so it covers `ip`. Keeps within
    Apple's TLS rules: <=825-day validity, SAN present, EKU serverAuth."""
    sans = ["IP:127.0.0.1", "DNS:localhost"]
    if ip and "IP:" + ip not in sans:
        sans.append("IP:" + ip)
    try:
        meta = json.load(open(CERT_META))
    except (OSError, ValueError):
        meta = {}
    if (
        os.path.exists(LEAF_CERT)
        and os.path.exists(LEAF_KEY)
        and os.path.exists(CHAIN)
        and meta.get("sans") == sans
    ):
        return False
    csr = os.path.join(STATE, "leaf.csr")
    ext = os.path.join(STATE, "leaf.ext")
    with open(ext, "w") as f:
        f.write(
            "subjectAltName=" + ",".join(sans) + "\n"
            "basicConstraints=CA:false\n"
            "keyUsage=digitalSignature,keyEncipherment\n"
            "extendedKeyUsage=serverAuth\n"
        )
    _openssl(
        "req", "-new", "-newkey", "rsa:2048", "-nodes",
        "-keyout", LEAF_KEY, "-out", csr, "-subj", "/CN=eyes",
    )
    _openssl(
        "x509", "-req", "-in", csr, "-CA", CA_CERT, "-CAkey", CA_KEY,
        "-CAcreateserial", "-days", "800", "-sha256", "-out", LEAF_CERT,
        "-extfile", ext,
    )
    os.chmod(LEAF_KEY, 0o600)
    with open(CHAIN, "w") as f:
        f.write(open(LEAF_CERT).read())
        f.write(open(CA_CERT).read())
    with open(CERT_META, "w") as f:
        json.dump({"sans": sans, "issued": int(time.time())}, f)
    for p in (csr, ext):
        try:
            os.remove(p)
        except OSError:
            pass
    return True


# ---------------------------------------------------------------- frame writes


_write_lock = threading.Lock()
_frame_count = 0


def save_frame(data):
    """Write one frame: timestamped history file + atomic update of latest.jpg.

    A reader of latest.jpg can never see a torn file: bytes go to a temp file
    first, then os.replace() (atomic on POSIX) swaps it in. latest.jpg is a
    hardlink to the history file, so the bytes are stored once."""
    global _frame_count
    ts = time.strftime("%Y%m%d-%H%M%S") + f"-{int(time.time() * 1000) % 1000:03d}"
    hist = os.path.join(HISTORY, f"frame-{ts}-{secrets.token_hex(2)}.jpg")
    tmp = os.path.join(STATE, f".tmp-{os.getpid()}-{secrets.token_hex(4)}")
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, hist)
    tmp2 = tmp + "L"
    os.link(hist, tmp2)
    os.replace(tmp2, LATEST)
    with _write_lock:
        _frame_count += 1
        if _frame_count % GC_EVERY == 0:
            gc(KEEP_COUNT, KEEP_BYTES, quiet=True)
    return hist


def gc(keep_count=KEEP_COUNT, keep_bytes=KEEP_BYTES, quiet=False):
    """Prune oldest history frames beyond the caps. Prints what it removes
    (a summary when called from the server, per-file when run as `eyes gc`)."""
    try:
        entries = sorted(
            (e for e in os.scandir(HISTORY) if e.name.startswith("frame-")),
            key=lambda e: e.name,
        )
    except FileNotFoundError:
        return 0
    total = sum(e.stat().st_size for e in entries)
    removed, freed = 0, 0
    while entries and (len(entries) > keep_count or total > keep_bytes):
        e = entries.pop(0)
        size = e.stat().st_size
        if not quiet:
            print(f"removed {e.path} ({size / 1024:.0f} KB)")
        os.remove(e.path)
        total -= size
        removed += 1
        freed += size
    if removed and quiet:
        print(f"gc: pruned {removed} old frames ({freed / 1024 / 1024:.1f} MB)")
    return removed


