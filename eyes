# ---------------------------------------------------------------------- server


class EyesServer(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, addr, ssl_ctx, token, e2e_key=None, require_e2e=False):
        super().__init__(addr, Handler)
        self.ssl_ctx = ssl_ctx
        self.token = token
        self.e2e_key = e2e_key
        self.require_e2e = require_e2e
        self.gcm = GCM() if e2e_key else None
        self.log_lock = threading.Lock()
        self.last_log = 0.0
        self.stamps = deque()  # frame timestamps for the rate limit

    # TLS handshake happens here, in the per-connection thread — a port
    # scanner or slow client can never stall the accept loop, and handshake
    # failures are dropped silently.
    def finish_request(self, request, client_address):
        request.settimeout(15)
        try:
            tls = self.ssl_ctx.wrap_socket(request, server_side=True)
        except OSError:
            try:
                request.close()
            except OSError:
                pass
            return
        tls.settimeout(60)
        try:
            self.RequestHandlerClass(tls, client_address, self)
        finally:
            try:
                tls.close()
            except OSError:
                pass

    def over_rate(self):
        now = time.monotonic()
        with self.log_lock:
            while self.stamps and now - self.stamps[0] > 1.0:
                self.stamps.popleft()
            if len(self.stamps) >= MAX_FPS:
                return True
            self.stamps.append(now)
            return False

    def log(self, line, always=False):
        with self.log_lock:
            now = time.monotonic()
            if always or now - self.last_log > 5:
                print(line, flush=True)
                self.last_log = now


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "eyes"
    sys_version = ""

    def log_message(self, fmt, *args):  # quiet; we log frames ourselves
        pass

    def _send(self, code, body, ctype="text/plain; charset=utf-8", extra=()):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in extra:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    _DRAIN_CAP = 64 * 1024 * 1024

    def _reject(self, n, code, body):
        """Refuse a POST. The claimed body is drained (bounded) first —
        responding while the client is still sending makes the closing socket
        RST and the client never sees the status code."""
        left = min(max(n, 0), self._DRAIN_CAP)
        while left > 0:
            chunk = self.rfile.read(min(left, 1 << 20))
            if not chunk:
                break
            left -= len(chunk)
        self.close_connection = True
        self._send(code, body)

    def _route(self):
        """Returns the sub-path after a valid /<token> prefix, else None."""
        path = self.path.split("?", 1)[0]
        seg = path.split("/", 2)
        if len(seg) >= 2 and hmac.compare_digest(seg[1], self.server.token):
            return path[len(self.server.token) + 1:]  # "", "/", "/frame", ...
        return None

    def do_GET(self):
        sub = self._route()
        if sub is None:
            return self._send(404, b"not found")
        if sub == "":
            return self._send(307, b"", extra=[("Location", self.path + "/")])
        if sub == "/":
            return self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        if sub == "/ping":
            return self._send(200, b'{"ok":true}', "application/json")
        if sub == "/ca":
            with open(CA_CERT, "rb") as f:
                return self._send(
                    200, f.read(), "application/x-x509-ca-cert",
                    extra=[("Content-Disposition",
                            'attachment; filename="eyes-ca.pem"')],
                )
        if sub == "/latest.jpg":
            if self.server.require_e2e:
                # In remote mode this response would transit Cloudflare in
                # the clear — the whole point is that frames never do.
                return self._send(403, b"disabled in remote mode")
            try:
                with open(LATEST, "rb") as f:
                    return self._send(200, f.read(), "image/jpeg")
            except OSError:
                return self._send(404, b"no frame yet")
        return self._send(404, b"not found")

    def do_POST(self):
        sub = self._route()
        try:
            n = int(self.headers.get("Content-Length", ""))
        except ValueError:
            n = -1
        if sub != "/frame":
            return self._reject(n, 404, b"not found")
        if n <= 0:
            return self._reject(n, 411, b"length required")
        if n > MAX_UPLOAD:
            return self._reject(n, 413, b"frame too large")
        if self.server.over_rate():
            return self._reject(n, 429, b"slow down")
        data = self.rfile.read(n)
        if len(data) != n:
            self.close_connection = True
            return self._send(400, b"truncated body")

        srv = self.server
        if data.startswith(MAGIC):
            if not srv.e2e_key:
                return self._send(400, b"server has no e2e key")
            iv, ct = data[4:16], data[16:]
            data = srv.gcm.open(srv.e2e_key, iv, ct)
            if data is None:
                srv.log(
                    f"DROPPED frame from {self.client_address[0]}: "
                    "decryption failed (wrong key or tampered)", always=True,
                )
                return self._send(400, b"decrypt failed")
        elif srv.require_e2e:
            srv.log(
                f"REFUSED plaintext frame from {self.client_address[0]} "
                "(remote mode requires e2e encryption)", always=True,
            )
            return self._send(400, b"encryption required")

        if not data.startswith(b"\xff\xd8"):
            return self._send(400, b"not a jpeg")
        save_frame(data)
        srv.log(
            f"frame from {self.client_address[0]} ({n / 1024:.0f} KB) -> {LATEST}"
        )
        self._send(200, b'{"ok":true}', "application/json")


# ------------------------------------------------------------- cloudflared bits


def cloudflared_bin():
    return shutil.which("cloudflared") or os.path.expanduser(
        "~/.local/bin/cloudflared"
    )


def _cfd(*args, **kw):
    return subprocess.run(
        (cloudflared_bin(),) + args, capture_output=True, text=True, **kw
    )


def tunnel_meta():
    try:
        return json.load(open(TUNNEL_META))
    except (OSError, ValueError):
        return {}


def write_tunnel_yml(meta, ip, port):
    """Ingress config: the tunnel terminates on this machine and forwards to
    the local HTTPS server. noTLSVerify because the origin cert is our own
    local CA — the hop is machine-internal (cloudflared runs right here)."""
    yml = (
        f"tunnel: {meta['id']}\n"
        f"credentials-file: {meta['credentials']}\n"
        "ingress:\n"
        f"  - hostname: {meta['hostname']}\n"
        f"    service: https://{ip}:{port}\n"
        "    originRequest:\n"
        "      noTLSVerify: true\n"
        "  - service: http_status:404\n"
    )
    changed = not (os.path.exists(TUNNEL_YML) and open(TUNNEL_YML).read() == yml)
    if changed:
        with open(TUNNEL_YML, "w") as f:
            f.write(yml)
    return changed


def systemctl_user(*args):
    return subprocess.run(
        ("systemctl", "--user") + args, capture_output=True, text=True
    )


def tunnel_active():
    return systemctl_user("is-active", UNIT_NAME).stdout.strip() == "active"


def cmd_tunnel_setup(args):
    ensure_state()
    if not os.path.exists(cloudflared_bin()):
        sys.exit(
            "eyes: cloudflared not found. Install the static binary into "
            "~/.local/bin (see README — verify the checksum)."
        )
    origin_cert = os.path.expanduser("~/.cloudflared/cert.pem")
    if not os.path.exists(origin_cert):
        sys.exit(
            "eyes: cloudflared is not logged in yet. Run this once (opens a "
            "browser, pick the zone your hostname lives under):\n\n"
            "    cloudflared tunnel login\n\n"
            "then re-run:  eyes tunnel setup " + args.hostname
        )
    name = "eyes"
    r = _cfd("tunnel", "list", "--output", "json")
    if r.returncode != 0:
        sys.exit("eyes: cloudflared tunnel list failed:\n" + r.stderr.strip())
    existing = {t["name"]: t["id"] for t in json.loads(r.stdout or "[]")}
    if name in existing:
        tid = existing[name]
        print(f"tunnel '{name}' already exists ({tid})")
    else:
        r = _cfd("tunnel", "create", name)
        if r.returncode != 0:
            sys.exit("eyes: tunnel create failed:\n" + r.stderr.strip())
        r = _cfd("tunnel", "list", "--output", "json")
        tid = {t["name"]: t["id"] for t in json.loads(r.stdout)}[name]
        print(f"created tunnel '{name}' ({tid})")
    creds = os.path.expanduser(f"~/.cloudflared/{tid}.json")
    if not os.path.exists(creds):
        sys.exit(f"eyes: expected credentials file missing: {creds}")

    r = _cfd("tunnel", "route", "dns", name, args.hostname)
    out = (r.stdout + r.stderr).strip()
    if r.returncode != 0 and "already exists" not in out.lower():
        sys.exit(f"eyes: DNS routing failed for {args.hostname}:\n{out}")
    print(f"DNS: {args.hostname} -> {tid}.cfargotunnel.com")

    meta = {
        "name": name, "id": tid, "credentials": creds, "hostname": args.hostname,
    }
    with open(TUNNEL_META, "w") as f:
        json.dump(meta, f, indent=1)
    write_tunnel_yml(meta, lan_ip() or "127.0.0.1", args.port)

    os.makedirs(os.path.dirname(UNIT_FILE), exist_ok=True)
    with open(UNIT_FILE, "w") as f:
        f.write(
            "[Unit]\n"
            "Description=eyes cloudflare tunnel (opt-in remote access)\n"
            "After=network-online.target\n\n"
            "[Service]\n"
            f"ExecStart={cloudflared_bin()} --no-autoupdate tunnel "
            f"--config {TUNNEL_YML} run\n"
            "Restart=on-failure\n"
            "RestartSec=5\n\n"
            "[Install]\n"
            "WantedBy=default.target\n"
        )
    systemctl_user("daemon-reload")
    print(f"""
tunnel is configured but NOT running (remote access stays opt-in).

  start it:   eyes tunnel up
  stop it:    eyes tunnel down
  serve for it: eyes serve --remote

STRONGLY RECOMMENDED — put Cloudflare Access in front (login wall before
anything reaches this machine): dash.cloudflare.com -> Zero Trust -> Access
-> Applications -> Add self-hosted app for {args.hostname}, policy = Allow,
include = your email, login method = One-time PIN. Details in the README.""")


def cmd_tunnel_up(args):
    if not tunnel_meta():
        sys.exit("eyes: no tunnel configured. Run: eyes tunnel setup HOSTNAME")
    systemctl_user("daemon-reload")
    r = systemctl_user("start", UNIT_NAME)
    if r.returncode != 0:
        sys.exit("eyes: failed to start tunnel:\n" + r.stderr.strip())
    print("tunnel up — remember: eyes serve --remote  (plain `serve` refuses "
          "unencrypted remote frames anyway)")


def cmd_tunnel_down(args):
    systemctl_user("stop", UNIT_NAME)
    print("tunnel down — nothing is reachable from outside your LAN now")


def cmd_tunnel_status(args):
    meta = tunnel_meta()
    if not meta:
        print("tunnel: not configured (eyes tunnel setup HOSTNAME)")
        return 1
    state = systemctl_user("is-active", UNIT_NAME).stdout.strip() or "unknown"
    print(f"tunnel:   {meta['name']} ({meta['id']})")
    print(f"hostname: https://{meta['hostname']}/")
    print(f"state:    {state}")
    return 0 if state == "active" else 1


# ------------------------------------------------------------------- commands


def cmd_serve(args):
    ensure_state()
    ip = args.bind or lan_ip()
    if not ip:
        sys.exit("eyes: could not determine LAN address; pass --bind IP")
    import ipaddress
    if not ipaddress.ip_address(ip).is_private:
        sys.exit(
            f"eyes: refusing to bind {ip} — not a private address. Remote "
            "access is done via `eyes tunnel`, never by binding public IPs."
        )
    token = get_token(fresh=args.fresh_token)
    meta = tunnel_meta()
    if args.remote and not meta:
        sys.exit("eyes: remote mode needs a tunnel. Run: eyes tunnel setup "
                 "HOSTNAME  (see README)")
    # E2E key: required for remote; reused on the LAN too once it exists so
    # one bookmarked URL (with #k=…) works in both modes.
    e2e_key = get_e2e_key(create=args.remote)
    if ensure_ca():
        print("generated local CA (once ever) -> " + CA_CERT)
    if ensure_leaf(ip):
        print(f"issued server certificate for {ip}")
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    ctx.load_cert_chain(CHAIN, LEAF_KEY)
    gc(quiet=True)

    srv = EyesServer((ip, args.port), ctx, token,
                     e2e_key=e2e_key, require_e2e=args.remote)
    frag = f"#k={b64u(e2e_key)}" if e2e_key else ""
    lan_url = f"https://{ip}:{args.port}/{token}/{frag}"
    print("\neyes is watching for frames.\n")
    if args.remote:
        remote_url = f"https://{meta['hostname']}/{token}/{frag}"
        print(f"  phone (anywhere): {remote_url}\n")
        print(f"  phone (same LAN): {lan_url}")
        print("  frames are end-to-end encrypted — the key after '#' never "
              "leaves the phone/this machine (URL fragments are not sent "
              "over the network). Cloudflare relays ciphertext only.")
        if write_tunnel_yml(meta, ip, args.port) and tunnel_active():
            print("  NOTE: tunnel config changed (IP/port) — restart it: "
                  "eyes tunnel down && eyes tunnel up")
        if not tunnel_active():
            print("  NOTE: tunnel is not running — start it: eyes tunnel up")
    else:
        print(f"  open on the phone:  {lan_url}")
    print(f"""
  latest frame:  {LATEST}
  history:       {HISTORY}  (capped: {KEEP_COUNT} frames / {KEEP_BYTES // 2**20} MB)

first time on this phone via LAN? the page walks you through the one-time
certificate install. the URL stays the same across restarts — add it to the
Home Screen. Ctrl-C to stop.""", flush=True)
    if shutil.which("qrencode"):
        subprocess.run(["qrencode", "-t", "ANSIUTF8",
                        remote_url if args.remote else lan_url])
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\neyes: stopped")


def cmd_latest(args):
    if os.path.exists(LATEST):
        print(LATEST)
        return 0
    print("eyes: no frame captured yet", file=sys.stderr)
    return 1


def cmd_wait(args):
    def mtime():
        try:
            return os.stat(LATEST).st_mtime_ns
        except OSError:
            return None

    before = mtime()
    deadline = time.monotonic() + args.timeout if args.timeout else None
    while True:
        time.sleep(0.15)
        m = mtime()
        if m is not None and m != before:
            print(LATEST)
            return 0
        if deadline and time.monotonic() > deadline:
            print("eyes: timed out waiting for a frame", file=sys.stderr)
            return 1


def cmd_gc(args):
    ensure_state()
    n = gc(args.keep, args.max_mb * 1024 * 1024)
    print(f"eyes: removed {n} frame(s)" if n else "eyes: nothing to prune")
    return 0


def main():
    p = argparse.ArgumentParser(
        prog="eyes", description="phone camera -> frames on disk, local-first"
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("serve", help="start the HTTPS server")
    s.add_argument("--port", type=int, default=8443)
    s.add_argument("--bind", help="LAN IP to bind (default: auto-detect)")
    s.add_argument("--remote", action="store_true",
                   help="serve for the Cloudflare tunnel too; requires e2e-"
                        "encrypted frames and refuses plaintext")
    s.add_argument("--fresh-token", action="store_true",
                   help="rotate the URL token (invalidates the old URL)")
    s.set_defaults(fn=cmd_serve)

    s = sub.add_parser("latest", help="print path of the newest frame")
    s.set_defaults(fn=cmd_latest)

    s = sub.add_parser("wait", help="block until a new frame arrives")
    s.add_argument("--timeout", type=float, default=None, metavar="SECS")
    s.set_defaults(fn=cmd_wait)

    s = sub.add_parser("gc", help="prune frame history")
    s.add_argument("--keep", type=int, default=KEEP_COUNT,
                   help=f"max frames to keep (default {KEEP_COUNT})")
    s.add_argument("--max-mb", type=int, default=KEEP_BYTES // 2**20,
                   help="max total MB of history")
    s.set_defaults(fn=cmd_gc)

    t = sub.add_parser("tunnel", help="opt-in remote access (Cloudflare Tunnel)")
    tsub = t.add_subparsers(dest="tcmd", required=True)
    s = tsub.add_parser("setup", help="one-time: create tunnel + DNS + unit")
    s.add_argument("hostname", help="e.g. eyes.example.dev")
    s.add_argument("--port", type=int, default=8443)
    s.set_defaults(fn=cmd_tunnel_setup)
    tsub.add_parser("up", help="start the tunnel").set_defaults(fn=cmd_tunnel_up)
    tsub.add_parser("down", help="stop the tunnel").set_defaults(fn=cmd_tunnel_down)
    tsub.add_parser("status", help="tunnel state").set_defaults(fn=cmd_tunnel_status)

    args = p.parse_args()
    sys.exit(args.fn(args) or 0)


if __name__ == "__main__":
    main()
